// Windows resources of launcher.exe: application icon, version information and manifest.
// build.sh compiles this with llvm-rc and passes the version from VERSION as
// VER_MAJOR, VER_MINOR, VER_PATCH and VER_STRING; the icon is generated by tools/make-icon.py.
// SignPath restricts signed files by these fields (product name, version, ...): keep them stable.

#define VS_VERSION_INFO 1
#define VS_FFI_FILEFLAGSMASK 0x3FL
#define VOS_NT_WINDOWS32 0x40004L
#define VFT_APP 0x1L
#define RT_MANIFEST 24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1

// Resource 1: the window class loads it with LoadIconW(hinstance, MAKEINTRESOURCE(1)).
1 ICON ICON_PATH

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName", "decode9"
            VALUE "FileDescription", "decode9 Launcher - installs, updates and starts a game"
            VALUE "FileVersion", VER_STRING
            VALUE "InternalName", "launcher"
            VALUE "LegalCopyright", "Copyright (c) 2026 decode9. MIT License."
            VALUE "OriginalFilename", "launcher.exe"
            VALUE "ProductName", "decode9 Launcher"
            VALUE "ProductVersion", VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
